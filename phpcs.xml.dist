<?xml version="1.0"?>
<ruleset name="CacheArmor">
	<description>Coding standards for the distributed plugin files.</description>

	<file>.</file>

	<!-- Command-line test harness and build output; neither is shipped as source. -->
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/>

	<rule ref="WordPress"/>

	<config name="minimum_wp_version" value="5.6"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="cachearmor"/>
		</properties>
	</rule>

	<!-- Every global class, constant, function, hook and variable carries the plugin's prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="cachearmor"/>
			</property>
		</properties>
	</rule>
</ruleset>
